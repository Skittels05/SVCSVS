    {
      "name": "Projects",
      "item": [
        {
          "name": "Создать",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Новый проект\",\n  \"description\": \"Описание проекта\",\n  \"project_type\": \"scrum\",\n  \"status\": \"planned\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"],
              "query": [
                {"key": "name", "value": "Новый проект", "description": "Название проекта"},
                {"key": "description", "value": "Описание проекта", "description": "Описание"},
                {"key": "project_type", "value": "scrum", "description": "Тип проекта (scrum/kanban и т.д.)"},
                {"key": "status", "value": "planned", "description": "Статус проекта"}
              ]
            }
          }
        },
        {
          "name": "Список (пагинация + сортировка + фильтр)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"],
              "query": [
                {"key": "page", "value": "1", "description": "Номер страницы"},
                {"key": "limit", "value": "10", "description": "Количество на странице"},
                {"key": "sort", "value": "name:desc", "description": "Поле:asc или Поле:desc"},
                {"key": "status", "value": "active", "description": "Фильтр по статусу"},
                {"key": "project_type", "value": "scrum", "description": "Тип проекта"}
              ]
            }
          }
        },
        {
          "name": "Поиск по полям",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"],
              "query": [
                {"key": "search", "value": "CRM", "description": "Строка поиска"},
                {"key": "searchFields", "value": "name,description", "description": "Поля через запятую"},
                {"key": "page", "value": "1", "description": "Номер страницы (опционально)"},
                {"key": "limit", "value": "10", "description": "Количество на странице (опционально)"},
                {"key": "sort", "value": "", "description": "Сортировка (опционально)"}
              ]
            }
          }
        },
        {
          "name": "По ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/:projectId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":projectId"],
              "variable": [{"key": "projectId", "value": "1", "description": "ID проекта"}]
            }
          }
        },
        {
          "name": "Обновить",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Обновлённый проект\",\n  \"status\": \"active\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/:projectId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":projectId"],
              "variable": [{"key": "projectId", "value": "1"}],
              "query": [
                {"key": "name", "value": "Обновлённый проект", "description": "Новое название"},
                {"key": "description", "value": "", "description": "Новое описание (опционально)"},
                {"key": "project_type", "value": "", "description": "Новый тип (опционально)"},
                {"key": "status", "value": "active", "description": "Новый статус"}
              ]
            }
          }
        },
        {
          "name": "Удалить",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/projects/:projectId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":projectId"],
              "variable": [{"key": "projectId", "value": "1"}]
            }
          }
        },
        {
          "name": "Проверка существования (HEAD)",
          "request": {
            "method": "HEAD",
            "url": {
              "raw": "{{baseUrl}}/api/projects/:projectId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", ":projectId"],
              "variable": [{"key": "projectId", "value": "1"}]
            }
          }
        }
      ]
